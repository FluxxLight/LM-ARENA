# ---------------------------------------------------------------------------
# IDEAForge — environment template. Copy to .env.local and fill the values.
# Never commit real keys. The secret key is server-only and must not be
# prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Used by route handlers/server actions for trusted writes:
# usage counters, entitlements, generation history, gamification and admin.
SUPABASE_SECRET_KEY=

# Public URL used by canonical links, sitemap, OG images and auth redirects.
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments — architecture only until a real gateway is connected.
# Allowed: mock | none
PAYMENT_PROVIDER=mock
# When true, the mock provider can simulate activation with zero charge.
MOCK_PAYMENT_MODE=true
# Required by a real provider; unused in mock mode.
PAYMENT_WEBHOOK_SECRET=

# Salt used to hash guest IPs for the anonymous daily limit.
IP_HASH_SALT=change-me

# Optional: makes the seed script fail the build instead of warning.
SEED_STRICT=0
